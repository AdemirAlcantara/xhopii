<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Xhopii - Funcionarios</title>
</head>
<body>
    <%- include('partials/cabecalho') %>
    <%- include('partials/menu') %>
    <main class="conteudo-visualizar">
        <section class="conteudo-visualizar-box">
            <h1>Funcionarios</h1>
            <% if (funcionarios.length === 0) { %>
                <p>Nao ha funcionarios cadastrados.</p>
            <% } else { %>
                <% funcionarios.forEach(funcionario => { %>
                    <% const formatarData = data => { const partes = new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date(data)); const valores = Object.fromEntries(partes.map(parte => [parte.type, parte.value])); return `${valores.hour}:${valores.minute} - ${valores.day}/${valores.month}/${valores.year}`; }; %>
                    <% const dataNascimento = new Date(funcionario.dataNascimento); %>
                    <section class="conteudo-bloco">
                        <% if (funcionario.imagem) { %><img class="objeto-imagem" src="<%= funcionario.imagem %>" alt="Foto de perfil"><% } %>
                        <section class="objeto-conteudo">
                            <section class="objeto-informacoes">
                                <h2><%= funcionario.nome %> <%= funcionario.sobrenome %></h2>
                                <p>CPF: <%= funcionario.cpf %></p>
                                <p>Data de Nascimento: <%= String(dataNascimento.getUTCDate()).padStart(2, '0') %>/<%= String(dataNascimento.getUTCMonth() + 1).padStart(2, '0') %>/<%= dataNascimento.getUTCFullYear() %></p>
                                <p>Telefone: <%= funcionario.telefone %></p>
                                <p>Cargo: <%= funcionario.cargo %></p>
                                <p>Salário: R$ <%= Number(funcionario.salario).toFixed(2) %></p>
                                <p>E-mail: <%= funcionario.email %></p>
                                <p>Data de criação: <%= formatarData(funcionario.createdAt) %></p>
                                <p>Última alteração: <%= formatarData(funcionario.updatedAt) %></p>
                            </section>
                            <section class="objeto-acoes">
                                <a class="link-acao" href="/funcionarios/<%= funcionario._id %>/atualizar">Alterar</a>
                                <a class="link-acao botao-excluir" href="/funcionarios/<%= funcionario._id %>/excluir">Excluir</a>
                            </section>
                        </section>
                    </section>
                <% }); %>
            <% } %>
        </section>
    </main>
    <%- include('partials/rodape') %>
</body>
</html>
