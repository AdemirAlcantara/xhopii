<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Xhopii - Resultado do cadastro</title>
</head>
<body>
    <%- include('partials/cabecalho') %>
    <%- include('partials/menu') %>

    <main class="conteudo-visualizar">
        <section class="conteudo-visualizar-box">
            <h1><%= sucesso ? 'Cadastro realizado' : 'Cadastro não realizado' %></h1>
            <p><%= message %></p>
            <p>
                <a href="/">Voltar para a home</a>
                <% if (voltar) { %>
                    <a href="<%= voltar %>">Voltar ao cadastro</a>
                <% } %>
            </p>
        </section>
    </main>
    <%- include('partials/rodape') %>
</body>
</html>
