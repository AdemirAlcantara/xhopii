<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Xhopii - Produtos</title>
</head>
<body>
    <%- include('partials/cabecalho') %>
    <%- include('partials/menu') %>
    <main class="conteudo-visualizar">
        <section class="conteudo-visualizar-box">
            <h1>Produtos</h1>
            <% if (produtos.length === 0) { %>
                <p>Nao ha produtos cadastrados.</p>
            <% } else { %>
                <% produtos.forEach(produto => { %>
                    <% const formatarData = data => { const partes = new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date(data)); const valores = Object.fromEntries(partes.map(parte => [parte.type, parte.value])); return `${valores.hour}:${valores.minute} - ${valores.day}/${valores.month}/${valores.year}`; }; %>
                    <section class="conteudo-bloco">
                        <% if (produto.imagem) { %><img class="objeto-imagem produto-lista-imagem" src="<%= produto.imagem %>" alt="<%= produto.nome %>"><% } %>
                        <section class="objeto-conteudo">
                            <section class="objeto-informacoes">
                                <h2><%= produto.nome %></h2>
                                <p>Fabricante: <%= produto.fabricante %></p>
                                <p>Descrição: <%= produto.descricao %></p>
                                <p>Preço: R$ <%= Number(produto.preco).toFixed(2) %></p>
                                <p>Quantidade disponível: <%= produto.estoque || 0 %></p>
                                <p>Data de criação: <%= formatarData(produto.createdAt) %></p>
                                <p>Última alteração: <%= formatarData(produto.updatedAt) %></p>
                            </section>
                            <section class="objeto-acoes">
                                <a class="link-acao" href="/produtos/<%= produto._id %>/atualizar">Alterar</a>
                                <a class="link-acao botao-excluir" href="/produtos/<%= produto._id %>/excluir">Excluir</a>
                            </section>
                        </section>
                    </section>
                <% }); %>
            <% } %>
        </section>
    </main>
    <%- include('partials/rodape') %>
</body>
</html>
