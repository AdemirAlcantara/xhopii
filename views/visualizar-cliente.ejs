<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="../css/style.css">
    <link rel="icon" href="../img/logo.png" type="image/png">
    <title>Xhopii - Ver Clientes</title>
</head>
<body>

    <%- include('partials/cabecalho') %>
    <%- include('partials/menu') %>

    <section class="conteudo-visualizar">
        <section class="conteudo-visualizar-box">
            <h1>Clientes</h1>
            <% if (clientes.length === 0) { %>
                <p>Não há clientes cadastrados.</p>
            <% } else { %>
                <% clientes.forEach(cliente => { %>
                <% const formatarData = data => { const partes = new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date(data)); const valores = Object.fromEntries(partes.map(parte => [parte.type, parte.value])); return `${valores.hour}:${valores.minute} - ${valores.day}/${valores.month}/${valores.year}`; }; %>
                <% const dataNascimento = new Date(cliente.dataNascimento); %>
                <% const nascimentoDia = String(dataNascimento.getUTCDate()).padStart(2, '0'); %>
                <% const nascimentoMes = String(dataNascimento.getUTCMonth() + 1).padStart(2, '0'); %>
                <% const nascimentoAno = dataNascimento.getUTCFullYear(); %>
                <section class="conteudo-bloco">
                    <% if (cliente.imagem) { %>
                        <img class="objeto-imagem" src="<%= cliente.imagem %>" alt="Foto de perfil de <%= cliente.nome %>">
                    <% } %>
                    <section class="objeto-conteudo">
                        <section class="objeto-informacoes">
                            <h2><%= cliente.nome %> <%= cliente.sobrenome %></h2>
                            <p>CPF: <%= cliente.cpf %></p>
                            <p>Data de Nascimento: <%= nascimentoDia %>/<%= nascimentoMes %>/<%= nascimentoAno %></p>
                            <p>Telefone: <%= cliente.telefone %></p>
                            <p>E-mail: <%= cliente.email %></p>
                            <p>Data de criação: <%= formatarData(cliente.createdAt) %></p>
                            <p>Última alteração: <%= formatarData(cliente.updatedAt) %></p>
                        </section>
                        <section class="objeto-acoes">
                            <a class="link-acao" href="/clientes/<%= cliente._id %>/atualizar">Alterar</a>
                            <a class="link-acao botao-excluir" href="/clientes/<%= cliente._id %>/excluir">Excluir</a>
                        </section>
                    </section>
                </section>
                <% }); %>
            <% } %>
        </section>
    </section>

    <footer class="rodape">
        <section class="conteudo-rodape-info">
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Atendimento ao cliente</h5>
                <a href="#">Central de Ajuda</a>
                <a href="#">Como Comprar</a>
                <a href="#">Métodos de Paramento</a>
                <a href="#">Garantia Xhopii</a>
                <a href="#">Devolução e Reembolso</a>
                <a href="#">Fale Conosco</a>
                <a href="#">Ouridoria</a>
                <a href="#">Preferências de cookies</a>
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Sobre a Xhopii</h5>
                <a href="#">Sobre Nós</a>
                <a href="#">Políticas Xhopii</a>
                <a href="#">Política de Privacidade</a>
                <a href="#">Programa de Ailiados da Xhopii</a>
                <a href="#">Seja um Entregador Xhopii</a>
                <a href="#">Ofertas Relâmpago</a>
                <a href="#">Xhopii Blog</a>
                <a href="#">Impresa</a>
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Pagamento</h5>
                <section class="conteudo-rodape-pagamento">
                    <img id="img-pagamento" src="/img/logo-visa.png">
                    <img id="img-pagamento" src="/img/logo-mastercard.png">
                    <img id="img-pagamento" src="/img/logo-hipercard.png">
                    <img id="img-pagamento" src="/img/logo-elo.png">
                    <img id="img-pagamento" src="/img/logo-american-express.png">
                    <img id="img-pagamento" src="/img/logo-boleto.png">
                    <img id="img-pagamento" src="/img/logo-pix.png">
                </section>               
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Siga-nos</h5>
                <a href="#"><img id="img-sociais" src="/img/logo-instagram.png">Instagram</a>
                <a href="#"><img id="img-sociais" src="/img/logo-tiktok.png">Tik Tok</a>
                <a href="#"><img id="img-sociais" src="/img/logo-twitter.png">X/Twitter</a>
                <a href="#"><img id="img-sociais" src="/img/logo-facebook.png">Facebook</a>
                <a href="#"><img id="img-sociais" src="/img/logo-linkedln.png">Linkedln</a>
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Atendimento ao cliente</h5>
                <img id="img-store" src="/img/qr-code.png">
                <img id="img-store" src="/img/logo-store-apple.png">
                <img id="img-store" src="/img/logo-google-play.png">
            </section>
        </section>
        <hr>
        <p>© 2025 Xhopii. Todos os direitos acadêmicos reservados</p>
    </footer>

</body>
</html>